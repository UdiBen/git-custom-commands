#!/bin/sh

# Fetch the latest changes from origin
git fetch

BASE_BRANCH=$(git base-branch) || exit 1

echo "Using base branch: $BASE_BRANCH"

# Ask user if the branch is private/local
printf "\033[1;33mIs this a private/local branch (only you work on it)? [y/N]:\033[0m "
read answer

HEAD_BEFORE=$(git rev-parse HEAD)

if [ "$answer" = "y" ] || [ "$answer" = "Y" ]; then
    # Private branch: use rebase + force push.
    # --fork-point finds where this branch diverged from the base, so commits
    # already merged to the base (e.g., via squash-merge of a parent branch)
    # are skipped instead of causing conflicts.
    FORK_POINT=$(git merge-base --fork-point origin/$BASE_BRANCH HEAD 2>/dev/null || git merge-base origin/$BASE_BRANCH HEAD)
    git rebase --onto origin/$BASE_BRANCH "$FORK_POINT"
    rebase_exit_code=$?

    if [ $rebase_exit_code -ne 0 ]; then
        echo "Please resolve the conflicts, then run: git rebase --continue"
        echo "When done, push with: git push --force-with-lease"
    elif [ "$(git rev-parse HEAD)" = "$HEAD_BEFORE" ]; then
        echo "Already up to date with $BASE_BRANCH, nothing to push."
    else
        git push --force-with-lease
    fi
else
    # Shared branch: use merge + push
    git merge origin/$BASE_BRANCH
    merge_exit_code=$?

    if [ $merge_exit_code -ne 0 ]; then
        echo "Please resolve the conflicts, commit, and push when ready."
    elif [ "$(git rev-parse HEAD)" = "$HEAD_BEFORE" ]; then
        echo "Already up to date with $BASE_BRANCH, nothing to push."
    else
        git push
    fi
fi
